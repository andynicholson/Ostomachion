config FFT_ACCEL
	bool "Ostomachion FFT accelerator driver"
	depends on DT_HAS_OSTOMACHION_FFT_ACCEL_ENABLED
	help
	  Enables the Zephyr MISC driver for the memory-mapped FFT hardware
	  accelerator.  Requires the matching DTS node (compatible =
	  "ostomachion,fft-accel") and the AXI DMA + BRAM peripherals to be
	  present in the design.

if FFT_ACCEL

module = FFT_ACCEL
module-str = fft_accel
source "subsys/logging/Kconfig.template.log_config"

config FFT_ACCEL_TIMEOUT_MS
	int "DMA completion timeout (milliseconds)"
	default 100
	range 10 10000
	help
	  Maximum time to wait for the S2MM DMA interrupt-on-completion after
	  a transfer is kicked off.  Increase on slow or heavily loaded systems.
	  Decrease to detect stalls faster on real-time applications.

endif # FFT_ACCEL
