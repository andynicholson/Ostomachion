/* SPDX-License-Identifier: Apache-2.0 */
#include <zephyr/dt-bindings/dt-util.h>

/*
 * app_accel.overlay — DTS overlay for the AXI FFT accelerator pipeline
 * Copyright (c) 2026  SPDX-License-Identifier: Apache-2.0
 *
 * Applied in addition to app.overlay and app_fpga.overlay when building
 * the accelerator firmware (prj_accel.conf or prj_shell.conf).
 *
 * Address map (XBUS region 0x40000000–0x4FFFFFFF):
 *   0x40000000  AXI DMA control registers    64 B   (AXI4-Lite)
 *   0x41000000  TX BRAM                      16 KB  (AXI4-Full)
 *   0x41004000  RX BRAM                      16 KB  (AXI4-Full)
 *
 * The FFT core is the Xilinx xfft IP instantiated in the block design.
 * It has no AXI4-Lite slave; it is driven purely via AXI4-Stream by the
 * AXI DMA and configured at synthesis time (forward, scale all stages).
 *
 * The DMA mm2s_introut and s2mm_introut are aggregated via xlconcat into
 * a single mext_irq_i line to NEORV32.  Zephyr maps this to IRQ 0 in the
 * NEORV32 external-interrupt domain.
 */

/ {
	soc {
		fft_accel: fft-accel@40000000 {
			compatible = "ostomachion,fft-accel";
			/* reg-names:  dma         tx_bram     rx_bram */
			reg = <0x40000000 0x40>,
			      <0x41000000 0x4000>,
			      <0x41004000 0x4000>;
			reg-names = "dma", "tx_bram", "rx_bram";
			bram-size = <16384>;
			/* mext_irq_i → Machine External Interrupt (MEI) = INTC IRQ 11 */
			interrupts = <11>;
			interrupt-parent = <&intc>;
			status = "okay";
		};
	};
};

/* No XBUS DTS node required: the AXI peripherals are directly
 * memory-mapped in the NEORV32 address space and accessed via MMIO. */

/* The FFT driver + ZTEST suite exceeds 64 KB; increase IMEM to 128 KB.
 * The NEORV32 IMEM in the block design must be configured to match. */
&imem {
	reg = <0x0 DT_SIZE_K(128)>;
};
