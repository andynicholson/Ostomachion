// Minimal <cstddef> for Ostomachion / Zephyr + picolibc.
// Provides everything Zephyr's own minimal <cstddef> provides, plus
// std::byte (C++17/20) which Zephyr omits.
//
// This file shadows the Zephyr minimal <cstddef> because the project's
// include/ directory is a -I path (searched first).

#pragma once

#include <stddef.h> // picolibc: size_t, ptrdiff_t, max_align_t, NULL

namespace std {
    using ::ptrdiff_t;
    using ::size_t;
    using ::max_align_t;
    using nullptr_t = decltype(nullptr);

    // std::byte (C++17) — uninterpreted octet, distinct from char/unsigned char
    enum class byte : unsigned char {};

    template<class Int>
    constexpr byte  operator<<(byte b, Int s) noexcept {
        return byte(static_cast<unsigned char>(b) << s);
    }
    template<class Int>
    constexpr byte  operator>>(byte b, Int s) noexcept {
        return byte(static_cast<unsigned char>(b) >> s);
    }
    template<class Int>
    constexpr byte& operator<<=(byte& b, Int s) noexcept { return b = b << s; }
    template<class Int>
    constexpr byte& operator>>=(byte& b, Int s) noexcept { return b = b >> s; }

    constexpr byte  operator| (byte l, byte r) noexcept {
        return byte(static_cast<unsigned char>(l) | static_cast<unsigned char>(r));
    }
    constexpr byte  operator& (byte l, byte r) noexcept {
        return byte(static_cast<unsigned char>(l) & static_cast<unsigned char>(r));
    }
    constexpr byte  operator^ (byte l, byte r) noexcept {
        return byte(static_cast<unsigned char>(l) ^ static_cast<unsigned char>(r));
    }
    constexpr byte  operator~ (byte b) noexcept {
        return byte(~static_cast<unsigned char>(b));
    }
    constexpr byte& operator|=(byte& l, byte r) noexcept { return l = l | r; }
    constexpr byte& operator&=(byte& l, byte r) noexcept { return l = l & r; }
    constexpr byte& operator^=(byte& l, byte r) noexcept { return l = l ^ r; }

    template<class Int>
    constexpr Int to_integer(byte b) noexcept { return static_cast<Int>(b); }
} // namespace std
