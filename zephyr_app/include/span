// Minimal <span> for Ostomachion / Zephyr + picolibc.
// Provides std::span<T> (dynamic extent only) — zero-overhead non-owning
// view of a contiguous sequence, compatible with -fno-exceptions.
//
// Static-extent specialisation is omitted; dynamic_extent is used throughout.

#pragma once

#include <cstddef>
#include <array>

namespace std {

inline constexpr size_t dynamic_extent = static_cast<size_t>(-1);

template<typename T, size_t Extent = dynamic_extent>
class span {
public:
    using value_type      = T;
    using size_type       = size_t;
    using pointer         = T*;
    using const_pointer   = const T*;
    using reference       = T&;
    using iterator        = T*;
    using const_iterator  = const T*;

    static constexpr size_type extent = dynamic_extent;

    // Default: empty span
    constexpr span() noexcept : data_(nullptr), size_(0) {}

    // From pointer + count (primary constructor)
    constexpr span(pointer ptr, size_type count) noexcept
        : data_(ptr), size_(count) {}

    // From mutable std::array<T, N> — for span<T> (mutable view)
    template<size_t N>
    constexpr span(array<T, N>& arr) noexcept
        : data_(arr.data()), size_(N) {}

    // From const std::array<U, N> — for span<const T> (read-only view).
    // U* must be implicitly convertible to T* (e.g. byte* -> const byte*).
    // If T is non-const and U is non-const, this overload still compiles but
    // data_(arr.data()) would assign const U* -> T* which is a compile error,
    // correctly preventing mutable spans from const arrays.
    template<typename U, size_t N>
    constexpr span(const array<U, N>& arr) noexcept
        : data_(arr.data()), size_(N) {}

    // Converting constructor: span<U> -> span<T>.
    // Handles span<byte> -> span<const byte> (const-qualification conversion).
    template<typename U, size_t OtherExtent>
    constexpr span(const span<U, OtherExtent>& other) noexcept
        : data_(other.data()), size_(other.size()) {}

    constexpr pointer   data()  const noexcept { return data_; }
    constexpr size_type size()  const noexcept { return size_; }
    constexpr bool      empty() const noexcept { return size_ == 0; }

    constexpr reference operator[](size_type i) const noexcept { return data_[i]; }

    constexpr iterator       begin()  const noexcept { return data_; }
    constexpr iterator       end()    const noexcept { return data_ + size_; }
    constexpr const_iterator cbegin() const noexcept { return data_; }
    constexpr const_iterator cend()   const noexcept { return data_ + size_; }

private:
    pointer   data_;
    size_type size_;
};

// CTAD deduction guides
template<typename T, size_t N>
span(T (&)[N]) -> span<T>;

template<typename T, size_t N>
span(array<T, N>&) -> span<T>;

template<typename T, size_t N>
span(const array<T, N>&) -> span<const T>;

} // namespace std
